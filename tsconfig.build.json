{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // src/ gets no ambient Node types, deliberately. A core that reads a file,
    // a clock or an environment variable is no longer deterministic, and a
    // decision record is only auditable if re-evaluating the same context
    // gives the same answer. Denying the types makes that a build failure
    // rather than something the purity suite has to notice at runtime.
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
